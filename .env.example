# OpenRouter — single key covers all models (free and paid)
# Get yours at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: direct provider keys (only needed if using direct provider models)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OLLAMA_BASE_URL=http://localhost:11434

DATABASE_PATH=./autopilot.db
VERIFICATION_SAMPLE_RATE=0.05
LOG_LEVEL=INFO
